{
  "expo": {
    "name": "Tesed",
    "slug": "tesed",
    "version": "1.1.1",
    "orientation": "portrait",
    "scheme": "tesed",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.tesed.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "pt.tesed.app",
            "CFBundleURLSchemes": [
              "tesed"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "pt.tesed.app",
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#009EAB"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": "8c51abfc-e5f9-4a67-b7eb-c3fd713d0366"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Tesed precisa de aceder às tuas fotos para as poderes enviar ao teu terapeuta.",
          "cameraPermission": "A Tesed precisa de aceder à câmara para poderes tirar e enviar fotos ao teu terapeuta."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#009EAB"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-symbol.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-symbol.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#FFFFFF"
          }
        }
      ]
    ],
    "owner": "maromaro11",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8c51abfc-e5f9-4a67-b7eb-c3fd713d0366"
    }
  }
}
