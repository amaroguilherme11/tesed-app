{
  "expo": {
    "name": "Tesed",
    "slug": "tesed",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tesed",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.tesed.app"
    },
    "android": {
      "package": "pt.tesed.app",
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#009EAB"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": "8c51abfc-e5f9-4a67-b7eb-c3fd713d0366"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#009EAB"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-symbol.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-symbol.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#FFFFFF"
          }
        }
      ]
    ],
    "owner": "maromaro11"
  }
}
